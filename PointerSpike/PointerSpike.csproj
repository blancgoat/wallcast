<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The WinRT Bluetooth projection needs a Windows SDK version on the framework, which the
         plain net8.0-windows the rest of the repo uses does not carry. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PointerSpike</AssemblyName>
    <RootNamespace>PointerSpike</RootNamespace>
  </PropertyGroup>
</Project>
