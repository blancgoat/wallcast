<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Bluetooth projection this needs to send a tap back to the device only exists on a
         framework that names a Windows SDK version. WinForms is unaffected. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Wallcast.ico</ApplicationIcon>
    <Version>1.3.0-beta.1</Version>
    <Product>Wallcast</Product>
    <Description>Live capture card, virtual camera or video as your Windows desktop wallpaper.</Description>
    <Copyright>GPL-3.0-or-later. See LICENSE.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows.GPL" Version="3.0.23.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <!-- Vortice pulls in System.Text.Json 9; without this the self-contained publish keeps the
         .NET 8 framework copy and the app fails to load it at startup. -->
    <PackageReference Include="System.Text.Json" Version="9.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- ApplicationIcon only reaches the exe's shell icon; the window and tray load this copy. -->
    <EmbeddedResource Include="Wallcast.ico" />
    <Content Include="../.tools/capture/*" Link="capture/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- A GPL binary has to travel with its licence and with where to get everyone's source. -->
    <Content Include="../LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../THIRD-PARTY.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The VLC package carries x86 and arm64 runtimes as well, 244 MB that an x64-only build can never
       load. Dropping them takes the publish folder from 642 MB to under 400 MB. -->
  <Target Name="TrimUnusedVlcRuntimes" AfterTargets="Publish">
    <ItemGroup>
      <UnusedVlc Include="$(PublishDir)libvlc/win-x86/**/*;$(PublishDir)libvlc/win-arm64/**/*" />
    </ItemGroup>
    <Delete Files="@(UnusedVlc)" />
    <RemoveDir Directories="$(PublishDir)libvlc/win-x86;$(PublishDir)libvlc/win-arm64" />
  </Target>
  <Target Name="CheckCaptureEngine" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../.tools/capture/ffmpeg.exe')" Text="Run scripts/setup-capture.ps1 to install the capture engine before building." />
  </Target>
</Project>
