<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows.GPL" Version="3.0.23.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <!-- Vortice pulls in System.Text.Json 9; without this the self-contained publish keeps the
         .NET 8 framework copy and the app fails to load it at startup. -->
    <PackageReference Include="System.Text.Json" Version="9.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../.tools/capture/*" Link="capture/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckCaptureEngine" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../.tools/capture/ffmpeg.exe')" Text="Run scripts/setup-capture.ps1 to install the capture engine before building." />
  </Target>
</Project>
